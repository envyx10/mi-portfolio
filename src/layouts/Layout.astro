---
import '../styles/globals.css';
import { PROFILE } from '@/constants/portfolio-data';

interface Props {
  title?: string;
}

const { title = `${PROFILE.name} · Portfolio` } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content={`Portfolio de ${PROFILE.name}, ${PROFILE.role} con background en diseño gráfico y web.`}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B0B0B" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Static noise tile for the dark sections (generated once, before first paint) -->
    <script is:inline>
      (() => {
        const SIZE = 256;
        let seed = 0x9e3779b9; // mulberry32: same grain on every visit
        const random = () => {
          seed = (seed + 0x6d2b79f5) | 0;
          let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
        const tile = document.createElement("canvas");
        tile.width = tile.height = SIZE;
        const ctx = tile.getContext("2d");
        const image = ctx.createImageData(SIZE, SIZE);
        const pixels = image.data;
        for (let i = 0; i < pixels.length; i += 4) {
          const gray = Math.max(0, Math.round(11 + (random() - 0.5) * 23));
          pixels[i] = pixels[i + 1] = pixels[i + 2] = gray;
          pixels[i + 3] = 255;
        }
        ctx.putImageData(image, 0, 0);
        document.documentElement.style.setProperty("--noise", `url(${tile.toDataURL()})`);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <slot />
    <script>
      // Local time for every [data-clock] on the page (header and footer)
      const fmt = new Intl.DateTimeFormat("es-ES", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Madrid" });
      const tick = () => document.querySelectorAll("[data-clock]").forEach((el) => (el.textContent = fmt.format(new Date())));
      tick();
      setInterval(tick, 30_000);
    </script>
  </body>
</html>
