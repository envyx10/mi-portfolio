---
import ExternalLink from '@/components/ExternalLink.astro';
import { CONTACT_EMAIL, CV_FILENAME, CV_PATH, SOCIAL_LINKS } from '@/constants/navigation';
import { PROFILE } from '@/constants/portfolio-data';
import { TECHNOLOGIES } from '@/constants/technologies';

const ticker = TECHNOLOGIES.join(' / ') + ' /';
---

<section class="hero noise">
  <canvas id="hero-sphere" aria-label="Esfera de partículas deformada por ruido" role="img"></canvas>

  <div class="top">
    <dl class="facts mono">
      <dt class="muted">Rol</dt><dd>{PROFILE.role}</dd>
      <dt class="muted">Actual</dt><dd>{PROFILE.company}</dd>
      <dt class="muted">Antes</dt><dd>{PROFILE.previousCompany}</dd>
      <dt class="muted">Origen</dt><dd>{PROFILE.background}</dd>
      <dt class="muted">Base</dt><dd>{PROFILE.city}, {PROFILE.country}</dd>
    </dl>

    <div class="card">
      <div class="card__bar mono"><span>(01) Intro</span><span>● {PROFILE.role} en {PROFILE.company}</span></div>
      <h1 class="card__title">Creando experiencias <span class="tape">digitales<span class="acc">.</span></span></h1>
      <p class="card__text">{PROFILE.intro}</p>
      <div class="card__cta mono">
        <a href="#projects" class="cta cta--acc">Ver proyectos <span>↓</span></a>
        <a href={CV_PATH} download={CV_FILENAME} class="cta">Descargar CV <span>↓</span></a>
      </div>
    </div>
  </div>

  <div class="socials mono">
    {SOCIAL_LINKS.map((l) => (
      <ExternalLink href={l.href} label={l.label}>{l.name} ↗</ExternalLink>
    ))}
    <a href={`mailto:${CONTACT_EMAIL}`}>Email ↗</a>
  </div>

  <div class="name bigname" aria-hidden="true">{PROFILE.name}</div>
</section>

<div class="ticker mono">
  <div class="ticker__track">
    <span>{ticker}</span>
    <span aria-hidden="true">{ticker}</span>
  </div>
</div>

<script>
  import { mountSphere } from '@/scripts/sphere';
  mountSphere(document.getElementById('hero-sphere') as HTMLCanvasElement);
</script>

<style>
  .hero {
    position: relative;
    height: clamp(680px, 94vh, 980px);
    overflow: hidden;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .top {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 32px;
    padding: 24px var(--pad);
  }
  .facts {
    margin: 0;
    display: grid;
    grid-template-columns: auto auto;
    gap: 6px 24px;
    align-self: flex-start;
  }
  .facts dd {
    margin: 0;
  }
  .card {
    width: min(420px, 100%);
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--ink);
  }
  .card__bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--ink);
    font-size: 11px;
  }
  .card__title {
    margin: 0;
    padding: 14px 12px 6px;
    font-size: clamp(36px, 3.6vw, 54px);
    line-height: 0.9;
    font-weight: 900;
    font-stretch: 72%;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .tape {
    background: var(--ink);
    color: var(--paper);
    padding: 0 0.08em;
  }
  .card__text {
    margin: 0;
    padding: 8px 12px 14px;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 500;
  }
  .card__cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--ink);
    font-weight: 700;
  }
  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 50px;
    padding: 0 12px;
  }
  .cta--acc {
    background: var(--acc);
    color: var(--ink);
  }
  .cta--acc:hover {
    color: var(--ink);
    filter: brightness(1.1);
  }
  .socials {
    position: absolute;
    z-index: 2;
    left: var(--pad);
    top: 50%;
    display: flex;
    flex-direction: column;
  }
  .socials a {
    padding: 10px 0;
  }
  .name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.06em;
    z-index: 1;
    padding: 0 10px;
  }
  @media (max-width: 720px) {
    .hero {
      height: auto;
      display: flex;
      flex-direction: column;
      padding-top: min(108vw, 62svh);
    }
    canvas {
      height: calc(min(108vw, 62svh) + 12vw);
    }
    .facts,
    .socials {
      display: none;
    }
    .name {
      position: relative;
      order: 1;
      bottom: auto;
      font-size: 17.6vw;
    }
    .top {
      order: 2;
      padding: 20px var(--pad) 28px;
    }
    .card {
      width: 100%;
    }
  }
  .ticker {
    position: relative;
    z-index: 3;
    background: var(--acc);
    color: var(--ink);
    overflow: hidden;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }
  .ticker__track {
    display: inline-flex;
    animation: ticker 42s linear infinite;
    padding: 14px 0;
  }
  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
    }
  }
  .ticker__track span {
    padding-right: 24px;
  }
</style>
