---
import { HeroContent } from '@/components/react/HeroContent';
import { HeroArrow } from '@/components/react/HeroArrow';
---

<section
  id="home"
  class="h-dvh flex flex-col relative overflow-hidden"
>
  <!-- Dot grid pattern -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, rgba(255,255,255,0.8) 1px, transparent 1px); background-size: 24px 24px;"></div>

  <!-- Gradient orbs -->
  <div class="absolute top-[15%] left-[15%] w-[600px] h-[600px] rounded-full pointer-events-none animate-blob opacity-50 blur-3xl"
    style="background: radial-gradient(circle, rgba(147,51,234,0.25) 0%, rgba(139,92,246,0.1) 40%, transparent 70%)"
  ></div>
  <div class="absolute top-[30%] right-[10%] w-[500px] h-[500px] rounded-full pointer-events-none animate-blob animation-delay-2000 opacity-40 blur-3xl"
    style="background: radial-gradient(circle, rgba(99,102,241,0.2) 0%, rgba(79,70,229,0.08) 40%, transparent 70%)"
  ></div>
  <div class="absolute bottom-[10%] left-[30%] w-[550px] h-[550px] rounded-full pointer-events-none animate-blob animation-delay-4000 opacity-35 blur-3xl"
    style="background: radial-gradient(circle, rgba(168,85,247,0.2) 0%, rgba(147,51,234,0.08) 40%, transparent 70%)"
  ></div>

  <!-- Top fade -->
  <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-black to-transparent"></div>

  <!-- Hero content -->
  <div class="w-full relative z-10 flex flex-col items-center justify-center flex-1 pt-20 sm:pt-24">
    <HeroContent client:load />
  </div>

  <!-- Arrow at bottom -->
  <div class="relative z-10 flex justify-center pb-8 sm:pb-10">
    <HeroArrow client:load />
  </div>
</section>
