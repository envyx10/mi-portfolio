---
import { CONTACT_EMAIL, CV_PATH, SOCIAL_LINKS } from '@/constants/navigation';

const socials = SOCIAL_LINKS.filter((l) => l.name !== 'Email');
const year = new Date().getFullYear();
---

<footer id="contact" class="footer noise">
  <div class="bar mono">
    <span>(05) Contacto</span>
    <span class="muted">Málaga, ES — <span data-clock>--:--</span></span>
    <span class="muted">Fullstack Developer en Bettergy</span>
  </div>

  <div class="cta">
    <p class="kicker mono"><i></i>Trabajemos juntos</p>
    <h2>Si tienes un proyecto en mente o simplemente quieres conectar, no dudes en escribirme<span class="acc">.</span></h2>
    <div class="mail">
      <a class="mail__link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL} <span class="arrow">↗</span></a>
      <button type="button" class="btn mail__copy" data-copy={CONTACT_EMAIL}>Copiar</button>
    </div>
  </div>

  <div class="cols">
    <div class="col">
      <p class="mono muted">Perfiles</p>
      <ul>
        {socials.map((l) => (
          <li><a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.ariaLabel}>{l.name} <span class="arrow">↗</span></a></li>
        ))}
      </ul>
    </div>
    <div class="col">
      <p class="mono muted">Índice</p>
      <ul>
        <li><a href="#home">Inicio</a></li>
        <li><a href="#about">Sobre mí</a></li>
        <li><a href="#projects">Proyectos</a></li>
      </ul>
    </div>
    <div class="col">
      <p class="mono muted">Currículum</p>
      <a class="btn cv" href={CV_PATH} download="CV_PabloGilDiaz.pdf">Descargar CV <span>↓</span></a>
    </div>
  </div>

  <div class="name cond" aria-hidden="true">Pablo Gil Díaz<span class="acc">.</span></div>

  <div class="legal mono">
    <span>© {year} Pablo Gil Díaz</span>
    <span class="muted">Astro + Three.js</span>
    <a href="#home">Volver arriba ↑</a>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copiado ✓';
        setTimeout(() => (btn.textContent = 'Copiar'), 2000);
      } catch {
        window.prompt('Copia el email manualmente:', btn.dataset.copy);
      }
    });
  });
</script>

<style>
  .footer {
    position: relative;
    z-index: 3;
    overflow: hidden;
    border-top: 1px solid var(--bone);
    color: var(--bone);
  }
  .bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    border-bottom: 1px solid var(--line);
  }
  .bar > span {
    padding: 14px var(--pad);
    border-right: 1px solid var(--line);
  }
  .bar > span:last-child {
    border-right: 0;
  }
  .cta {
    padding: clamp(56px, 8vw, 128px) var(--pad) clamp(40px, 5vw, 72px);
  }
  .kicker {
    margin: 0 0 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }
  .kicker i {
    width: 10px;
    height: 10px;
    background: var(--acc);
  }
  h2 {
    margin: 0 0 28px;
    max-width: 1100px;
    font-size: clamp(40px, 5.4vw, 88px);
    line-height: 0.92;
    font-weight: 900;
    font-stretch: 70%;
    text-transform: uppercase;
  }
  .mail {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--bone);
    width: fit-content;
    max-width: 100%;
  }
  .mail__link {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 72px;
    padding: 0 24px;
    background: var(--acc);
    color: var(--ink);
    font-size: clamp(18px, 2.4vw, 34px);
    font-weight: 800;
    font-stretch: 75%;
    overflow-wrap: anywhere;
    transition: filter 0.2s;
  }
  .mail__link:hover {
    color: var(--ink);
    filter: brightness(1.1);
  }
  .mail__copy {
    min-height: 72px;
    border: 0;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    border-top: 1px solid var(--line);
  }
  .col {
    padding: 20px var(--pad) 28px;
    border-right: 1px solid var(--line);
  }
  .col:last-child {
    border-right: 0;
  }
  .col p {
    margin: 0 0 14px;
    font-size: 11px;
  }
  .col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 26px;
    font-weight: 800;
    font-stretch: 72%;
    text-transform: uppercase;
  }
  .col li a {
    display: inline-flex;
    gap: 8px;
    padding: 6px 0;
  }
  .cv {
    min-height: 52px;
    gap: 24px;
  }
  .name {
    padding: 0.04em 10px 0;
    margin-bottom: -0.06em;
    border-top: 1px solid var(--line);
    font-size: 17.4vw;
    line-height: 0.8;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .legal {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 14px var(--pad);
    background: var(--ink);
    border-top: 1px solid var(--line);
  }
</style>
