---
import { CopyEmail } from '@/components/react/CopyEmail';
import { SOCIAL_LINKS } from '@/constants/navigation';

const currentYear = new Date().getFullYear();
const githubLink = SOCIAL_LINKS.find(l => l.name === "GitHub")!;
const gitlabLink = SOCIAL_LINKS.find(l => l.name === "GitLab")!;
const linkedinLink = SOCIAL_LINKS.find(l => l.name === "LinkedIn")!;
---

<footer id="contact" class="relative py-16 sm:py-20 px-4 sm:px-6">
  <!-- Top separator -->
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-zinc-800/50 to-transparent"></div>

  <div class="max-w-[80%] mx-auto">

    <!-- CTA Section -->
    <div class="text-center mb-12 sm:mb-16">
      <p class="text-xs text-zinc-600 tracking-[0.25em] uppercase font-medium mb-4">Contacto</p>
      <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-4">
        <span class="bg-gradient-to-r from-white to-zinc-400 bg-clip-text text-transparent">
          Trabajemos juntos
        </span>
      </h3>
      <p class="text-zinc-600 text-sm sm:text-base max-w-md mx-auto mb-8">
        Si tienes un proyecto en mente o simplemente quieres conectar, no dudes en escribirme.
      </p>
      <CopyEmail client:visible />
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-zinc-800/40">
      <p class="text-zinc-700 text-xs">
        &copy; {currentYear} Pablo Gil Diaz
      </p>

      <div class="flex items-center gap-4">
        <a
          href={githubLink.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-700 hover:text-zinc-300 transition-colors duration-200"
          aria-label={githubLink.ariaLabel}
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
          </svg>
        </a>
        <a
          href={gitlabLink.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-700 hover:text-orange-400 transition-colors duration-200"
          aria-label={gitlabLink.ariaLabel}
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22.65 14.39L12 22.13 1.35 14.39a.84.84 0 0 1-.3-.94l1.22-3.78 2.44-7.51A.42.42 0 0 1 4.82 2a.43.43 0 0 1 .58 0 .42.42 0 0 1 .11.18l2.44 7.49h8.1l2.44-7.51A.42.42 0 0 1 18.6 2a.43.43 0 0 1 .58 0 .42.42 0 0 1 .11.18l2.44 7.51L23 13.45a.84.84 0 0 1-.35.94z"/>
          </svg>
        </a>
        <a
          href={linkedinLink.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-700 hover:text-zinc-300 transition-colors duration-200"
          aria-label={linkedinLink.ariaLabel}
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z" />
            <circle cx="4" cy="4" r="2" />
          </svg>
        </a>
      </div>

      <p class="text-zinc-800 text-xs">
        Astro + React + Tailwind
      </p>
    </div>
  </div>
</footer>
