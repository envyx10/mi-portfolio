---
import { CONTACT_EMAIL, CV_PATH, SOCIAL_LINKS } from '@/constants/navigation';

const year = new Date().getFullYear();
---

<footer id="contact" class="footer noise">
  <div class="bar mono">
    <span>(05) Contacto</span>
    <span class="muted">Málaga, ES — <span data-clock>--:--</span></span>
    <span class="muted">Fullstack Developer en Bettergy</span>
  </div>

  <div class="cta">
    <h2 class="cond">Trabajemos juntos<span class="acc">.</span></h2>
    <div class="cta__grid">
      <div class="cta__text">
        <p class="kicker mono"><i></i>¿Tienes algo en mente?</p>
        <p class="lead">Si tienes un proyecto en mente o simplemente quieres conectar, no dudes en escribirme.</p>
      </div>
      <div class="mail">
        <a class="mail__link" href={`mailto:${CONTACT_EMAIL}`}>
          <span class="mono mail__label">Email</span>
          <span class="mail__addr">{CONTACT_EMAIL}</span>
          <span class="arrow mail__arrow">↗</span>
        </a>
        <button type="button" class="mail__copy mono" data-copy={CONTACT_EMAIL}>Copiar email</button>
        <span class="sr-only" role="status" data-copy-status></span>
      </div>
    </div>
  </div>

  <div class="cols">
    <div class="col">
      <p class="mono muted">Perfiles</p>
      <ul>
        {SOCIAL_LINKS.map((l) => (
          <li><a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.ariaLabel}>{l.name} <span class="arrow">↗</span></a></li>
        ))}
      </ul>
    </div>
    <div class="col">
      <p class="mono muted">Índice</p>
      <ul>
        <li><a href="#home">Inicio</a></li>
        <li><a href="#about">Sobre mí</a></li>
        <li><a href="#projects">Proyectos</a></li>
      </ul>
    </div>
    <div class="col">
      <p class="mono muted">Currículum</p>
      <a class="btn cv" href={CV_PATH} download="CV_PabloGilDiaz.pdf">Descargar CV <span>↓</span></a>
    </div>
  </div>

  <div class="name cond" aria-hidden="true">Pablo Gil Díaz<span class="acc">.</span></div>

  <div class="legal mono">
    <span>© {year} Pablo Gil Díaz</span>
    <span class="muted">Astro + Three.js</span>
    <a href="#home">Volver arriba ↑</a>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copiado ✓';
        const status = btn.parentElement?.querySelector('[data-copy-status]');
        if (status) status.textContent = 'Email copiado al portapapeles';
        setTimeout(() => (btn.textContent = 'Copiar email'), 2000);
      } catch {
        window.prompt('Copia el email manualmente:', btn.dataset.copy);
      }
    });
  });
</script>

<style>
  .footer {
    position: relative;
    z-index: 3;
    overflow: hidden;
    border-top: 1px solid var(--bone);
    color: var(--bone);
  }
  .bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    border-bottom: 1px solid var(--line);
  }
  .bar > span {
    padding: 14px var(--pad);
    border-right: 1px solid var(--line);
  }
  .bar > span:last-child {
    border-right: 0;
  }
  .cta {
    padding: clamp(48px, 7vw, 112px) var(--pad) clamp(40px, 5vw, 72px);
  }
  h2 {
    margin: 0 0 clamp(32px, 4vw, 56px);
    font-size: clamp(36px, 11.4vw, 200px);
    line-height: 0.8;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .cta__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 48px;
    align-items: stretch;
  }
  .cta__text {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }
  .kicker {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }
  .kicker i {
    width: 10px;
    height: 10px;
    background: var(--acc);
  }
  .lead {
    margin: 0;
    max-width: 460px;
    font-size: clamp(19px, 1.6vw, 24px);
    line-height: 1.4;
    color: var(--soft);
  }
  .mail {
    flex: 1.6 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--acc);
  }
  .mail__link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px 24px;
    padding: 20px 24px 24px;
    background: var(--acc);
    color: var(--ink);
    transition: filter 0.2s;
  }
  .mail__link:hover {
    color: var(--ink);
    filter: brightness(1.1);
  }
  .mail__label {
    grid-column: 1 / -1;
  }
  .mail__addr {
    align-self: end;
    font-size: clamp(22px, 3.5vw, 58px);
    line-height: 1;
    font-weight: 900;
    font-stretch: 68%;
    overflow-wrap: anywhere;
  }
  .mail__arrow {
    align-self: end;
    font-size: clamp(28px, 3vw, 48px);
    line-height: 1;
  }
  .mail__copy {
    min-height: 52px;
    padding: 0 24px;
    background: transparent;
    color: var(--bone);
    border: 0;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .mail__copy:hover {
    background: var(--bone);
    color: var(--ink);
  }
  @media (max-width: 720px) {
    .bar > span:last-child {
      display: none;
    }
    .bar {
      grid-template-columns: 1fr 1fr;
    }
    .mail__link {
      grid-template-columns: 1fr;
      padding: 18px 16px 20px;
    }
    .mail__addr {
      font-size: 5.6vw;
      overflow-wrap: normal;
    }
    .mail__arrow {
      display: none;
    }
    .mail__copy {
      padding: 0 16px;
    }
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .col:nth-child(2) {
      border-right: 0;
    }
    .col:last-child {
      grid-column: 1 / -1;
      border-top: 1px solid var(--line);
    }
    .col ul {
      font-size: 22px;
    }
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    border-top: 1px solid var(--line);
  }
  .col {
    padding: 20px var(--pad) 28px;
    border-right: 1px solid var(--line);
  }
  .col:last-child {
    border-right: 0;
  }
  .col p {
    margin: 0 0 14px;
    font-size: 11px;
  }
  .col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 26px;
    font-weight: 800;
    font-stretch: 72%;
    text-transform: uppercase;
  }
  .col li a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
  .cv {
    min-height: 52px;
    gap: 24px;
  }
  .name {
    padding: 0.04em 10px 0;
    margin-bottom: -0.06em;
    border-top: 1px solid var(--line);
    font-size: 17.4vw;
    line-height: 0.8;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .legal {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 14px var(--pad);
    background: var(--ink);
    border-top: 1px solid var(--line);
  }
  .legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: -14px 0;
  }
</style>
