---
import { TechMarquee } from '@/components/react/TechMarquee';
---

<section
  id="tech-stack"
  class="py-16 sm:py-20 relative overflow-hidden"
>
<div class="max-w-[80%] mx-auto mb-10 sm:mb-14 text-center">
    <p class="text-xs text-zinc-600 tracking-[0.25em] uppercase font-medium mb-4">Stack Tecnológico</p>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight">
      <span class="bg-gradient-to-r from-white via-zinc-200 to-zinc-500 bg-clip-text text-transparent">
        Herramientas que uso a diario
      </span>
    </h2>
  </div>

  <TechMarquee client:visible />
</section>
