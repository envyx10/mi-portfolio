---
import { ProjectsTitle } from '../react/ProjectsTitle';
import { ProjectCard } from '../react/ProjectCard';
import { PROJECTS } from '@/constants/portfolio-data';
---

<section id="projects" class="relative pt-8 pb-28 sm:pb-32 px-4 sm:px-6">
  <div class="max-w-[80%] mx-auto w-full">
    <!-- Título con animación (React) -->
    <div class="mb-8 sm:mb-12 md:mb-16">
      <ProjectsTitle 
        client:visible 
        title="Mis Proyectos" 
        description="Aquí tienes una selección de proyectos que demuestran mis habilidades en desarrollo frontend, mostrando mi capacidad para construir aplicaciones web completas y funcionales."
      />
    </div>

    <!-- Grid de proyectos con animaciones (React) - Responsive -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-6 md:gap-8 place-items-stretch">
      {PROJECTS.map((project) => (
        <div class="flex h-full min-h-[350px] sm:min-h-[400px] md:min-h-[450px]">
          <ProjectCard project={project} client:visible />
        </div>
      ))}
    </div>
  </div>
</section>
