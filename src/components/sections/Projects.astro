---
import ExternalLink from '@/components/ExternalLink.astro';
import { PROJECTS, PROJECTS_INTRO } from '@/constants/portfolio-data';

const host = (url: string) => new URL(url).host.replace(/^www\./, '');
const pad = (n: number) => String(n).padStart(2, '0');

const projects = PROJECTS.map((p, i) => {
  // Main link: the live site if there is one, otherwise the repo (or nothing)
  const mainUrl = p.websiteUrl ?? p.githubUrl;
  const mainLabel = !p.websiteUrl ? 'Ver código ↗' : p.websiteUrl.includes('figma.com') ? 'Ver en Figma ↗' : 'Ver web ↗';
  return {
    ...p,
    idx: pad(i + 1),
    mainUrl,
    mainLabel,
    displayUrl: mainUrl ? host(mainUrl) : 'sin enlace público',
    codeUrl: p.websiteUrl ? p.githubUrl : undefined, // avoid a second button pointing to the same repo
  };
});
---

<section id="projects" class="projects noise">
  <div class="head">
    <h2 class="cond">Proyectos<sup class="mono acc">({PROJECTS.length})</sup></h2>
    <span class="mono muted">(04) Index — pasa el ratón por un proyecto</span>
    <p class="head__intro">{PROJECTS_INTRO}</p>
  </div>

  <div class="body" data-projects>
    <div class="list">
      <div role="tablist" aria-label="Proyectos" aria-orientation="vertical">
        {projects.map((p, i) => (
          <button
            type="button"
            role="tab"
            id={`project-tab-${i}`}
            aria-controls={`project-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class:list={['item', { 'is-active': i === 0 }]}
          >
            <span class="item__idx mono">{p.idx}</span>
            <span class="item__name cond">{p.title}</span>
            <span class="item__kind mono">{p.kind}</span>
          </button>
        ))}
      </div>
      <div class="list__foot mono muted">
        <span><span data-counter>01</span> / {pad(projects.length)}</span>
        <span>↑ ↓ para navegar</span>
      </div>
    </div>

    <div class="stage">
      {projects.map((p, i) => (
        <div
          role="tabpanel"
          id={`project-panel-${i}`}
          aria-labelledby={`project-tab-${i}`}
          class:list={['preview', { 'is-active': i === 0 }]}
        >
          <div class="preview__head">
            <span class="mono acc">{p.idx}</span>
            <h3 class="cond">{p.title}</h3>
            <span class="mono muted">{p.kind}</span>
          </div>
          {p.mainUrl ? (
            <ExternalLink class="frame" href={p.mainUrl} label={`Abrir ${p.title}`}>
              <div class="frame__bar mono">
                <span class="dots"><i></i><i></i><i class="dot-acc"></i></span>
                <span class="frame__url">{p.displayUrl}</span>
                <span>↗</span>
              </div>
              <div class="frame__img">
                <img src={p.image} alt={`Captura de ${p.title}`} width="1920" height="1080" loading="lazy" />
              </div>
            </ExternalLink>
          ) : (
            <div class="frame">
              <div class="frame__bar mono">
                <span class="dots"><i></i><i></i><i class="dot-acc"></i></span>
                <span class="frame__url">{p.displayUrl}</span>
              </div>
              <div class="frame__img">
                <img src={p.image} alt={`Captura de ${p.title}`} width="1920" height="1080" loading="lazy" />
              </div>
            </div>
          )}
          <div class="preview__info">
            <p>{p.description}</p>
            <div class="preview__links">
              {p.mainUrl && <ExternalLink class="btn btn--acc" href={p.mainUrl}>{p.mainLabel}</ExternalLink>}
              {p.codeUrl && <ExternalLink class="btn" href={p.codeUrl}>Código ↗</ExternalLink>}
            </div>
          </div>
          <div class="chips">{p.technologies.map((t) => <span>{t}</span>)}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Vertical tabs (WAI-ARIA APG): hover/focus/click select, arrows/Home/End move between tabs
  document.querySelectorAll<HTMLElement>('[data-projects]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = root.querySelectorAll<HTMLElement>('[role="tabpanel"]');
    const counter = root.querySelector('[data-counter]');
    const select = (i: number) => {
      tabs.forEach((el, j) => {
        el.classList.toggle('is-active', i === j);
        el.setAttribute('aria-selected', String(i === j));
        el.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((el, j) => el.classList.toggle('is-active', i === j));
      if (counter) counter.textContent = String(i + 1).padStart(2, '0');
    };
    tabs.forEach((el, i) => {
      for (const ev of ['mouseenter', 'focus', 'click']) el.addEventListener(ev, () => select(i));
      el.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: last }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        tabs[(next + tabs.length) % tabs.length]?.focus();
      });
    });
  });
</script>

<style>
  .projects {
    position: relative;
    z-index: 3;
    color: var(--bone);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    padding: clamp(40px, 6vw, 96px) var(--pad) 28px;
    border-bottom: 1px solid var(--bone);
  }
  .head h2 {
    margin: 0;
    font-size: clamp(64px, 9vw, 150px);
    line-height: 0.82;
  }
  .head__intro {
    flex-basis: 100%;
    max-width: 640px;
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--soft);
  }
  .head sup {
    font-size: 14px;
    font-weight: 500;
    font-stretch: 100%;
    vertical-align: top;
  }
  .body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
  }
  .list {
    flex: 1 1 440px;
    min-width: 0;
    border-right: 1px solid var(--line);
  }
  .item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px var(--pad);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    box-shadow: inset 6px 0 0 transparent;
    color: #6a6762;
    text-align: left;
    cursor: pointer;
    font: inherit;
    transition: color 0.25s, box-shadow 0.25s;
  }
  .item.is-active {
    color: var(--bone);
    box-shadow: inset 6px 0 0 var(--acc);
  }
  .item__idx {
    align-self: flex-start;
    padding-top: 8px;
    text-transform: none;
  }
  .item__name {
    flex: 1 1 auto;
    min-width: 0;
    font-size: clamp(44px, 5.6vw, 92px);
    line-height: 0.86;
  }
  .item__kind {
    font-size: 11px;
  }
  .list__foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px var(--pad);
  }
  .stage {
    flex: 1.45 1 560px;
    min-width: 0;
    padding: 24px var(--pad) 40px;
    display: grid;
  }
  .preview {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 18px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    transition: opacity 0.45s ease, transform 0.45s ease, visibility 0.45s;
  }
  .preview.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .frame {
    display: block;
    border: 1px solid var(--bone);
    background: #161615;
    transition: border-color 0.2s;
  }
  .frame:hover {
    border-color: var(--acc);
  }
  .frame__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--bone);
    font-size: 11px;
    text-transform: none;
  }
  .dots {
    display: flex;
    gap: 5px;
  }
  .dots i {
    width: 8px;
    height: 8px;
    border: 1px solid var(--bone);
    box-sizing: border-box;
  }
  .dots .dot-acc {
    background: var(--acc);
    border-color: var(--acc);
  }
  .frame__url {
    flex: 1;
    color: var(--muted);
  }
  .frame__img {
    overflow: hidden;
  }
  .frame__img img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .frame:hover img {
    transform: scale(1.04);
  }
  .preview__info {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: flex-start;
  }
  .preview__info p {
    flex: 1 1 320px;
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: var(--soft);
  }
  .preview__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .preview__head {
    display: none;
  }
  @media (max-width: 720px) {
    .list {
      display: none;
    }
    .stage {
      display: flex;
      flex-direction: column;
      gap: 56px;
      padding-top: 32px;
    }
    .preview {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .preview__head {
      display: flex;
      align-items: baseline;
      gap: 12px;
    }
    .preview__head h3 {
      flex: 1;
      margin: 0;
      font-size: 48px;
      line-height: 0.86;
    }
    .head .mono {
      display: none;
    }
  }
</style>
